            "grammar": {
                "ruleVi": "Trước một danh từ số ít đếm được phải có a hoặc an. Dùng \"an\" khi từ sau bắt đầu bằng một nguyên âm (a, e, i, o, u), dùng \"a\" trong các trường hợp còn lại. Nói nghề nghiệp cũng phải có a/an.",
                "forms": [
                    { "label": "a + phụ âm", "example": "a student, a doctor, a nurse" },
