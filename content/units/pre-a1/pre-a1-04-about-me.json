        {
            "slug": "be-present",
            "type": "GRAMMAR",
            "text": "am / is / are",
            "meaningVi": "động từ \"be\" ở hiện tại: là, thì, ở",
            "examples": [
                { "en": "I am Nam. She is Hoa. We are friends.", "vi": "Mình là Nam. Cô ấy là Hoa. Chúng mình là bạn.", "highlight": "am" }
            ],
            "grammar": {
                "ruleVi": "Động từ \"be\" đổi theo chủ ngữ: I đi với am; he, she, it đi với is; you, we, they đi với are. Khi nói thường rút gọn: I'm, you're, he's, she's, it's, we're, they're.",
                "forms": [
                    { "label": "I + am (I'm)", "example": "I'm Lan." },
                    { "label": "he / she / it + is ('s)", "example": "He's Tom. She's Hoa." },
                    { "label": "you / we / they + are ('re)", "example": "We're students. They're teachers." }
                ],
                "pitfallsVi": [
                    "Bỏ mất \"be\": \"I Lan\", \"She teacher\" → \"I'm Lan\", \"She's a teacher\".",
                    "Chia sai: \"He are\", \"They is\" → \"He is\", \"They are\".",
                    "Thêm \"be\" vào trước động từ khác: \"I'm live in Hanoi\" → \"I live in Hanoi\"."
                ]
            }
        },
