                "pitfallsVi": [
                    "Thêm be vào trước động từ: \"I'm get up at six\" → \"I get up at six\".",
                    "Phủ định bằng not: \"I not watch TV\" → \"I don't watch TV\".",
                    "Quên Do trong câu hỏi: \"You go to school?\" → \"Do you go to school?\"."
                ]
            }
