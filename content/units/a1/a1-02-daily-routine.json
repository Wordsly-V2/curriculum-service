            "grammar": {
                "ruleVi": "Dùng hiện tại đơn để nói thói quen và việc lặp đi lặp lại. Với I, you, we, they: dùng động từ nguyên dạng. Phủ định thêm don't trước động từ. Câu hỏi đặt Do lên đầu.",
                "forms": [
                    { "label": "Khẳng định", "example": "I get up at six. They study English." },
                    { "label": "Phủ định: don't + động từ", "example": "We don't watch TV." },
                    { "label": "Câu hỏi: Do … + động từ?", "example": "Do you go to work by bus? Yes, I do. / No, I don't." }
