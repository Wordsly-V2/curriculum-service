        {
            "slug": "this-that-these-those",
            "type": "GRAMMAR",
            "text": "this / that / these / those",
            "meaningVi": "này, kia (số ít và số nhiều)",
            "examples": [
                { "en": "This bag is red. Those bags are black.", "vi": "Cái túi này màu đỏ. Mấy cái túi kia màu đen.", "highlight": "Those" }
            ],
            "grammar": {
                "ruleVi": "this, these chỉ vật ở gần; that, those chỉ vật ở xa. this, that đi với danh từ số ít và \"is\"; these, those đi với danh từ số nhiều và \"are\".",
                "forms": [
                    { "label": "gần, số ít", "example": "This pen is blue." },
                    { "label": "gần, số nhiều", "example": "These pens are blue." },
                    { "label": "xa, số ít", "example": "That bag is cheap." },
                    { "label": "xa, số nhiều", "example": "Those bags are cheap." }
                ],
                "pitfallsVi": [
                    "\"this pens\", \"that books\" → these pens, those books.",
                    "\"These is\" → These are; \"This are\" → This is.",
                    "Đọc these giống this: these /ðiːz/ có i dài và âm cuối /z/."
                ]
            }
        },
