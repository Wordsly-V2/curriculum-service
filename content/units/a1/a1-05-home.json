        {
            "slug": "prepositions-of-place",
            "type": "GRAMMAR",
            "text": "in / on / under / next to / behind / in front of",
            "meaningVi": "giới từ chỉ nơi chốn",
            "examples": [
                { "en": "The keys are on the table, next to the lamp.", "vi": "Chìa khóa ở trên bàn, cạnh cái đèn.", "highlight": "next to" }
