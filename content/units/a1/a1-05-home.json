        {
            "slug": "there-is-there-are",
            "type": "GRAMMAR",
            "text": "there is / there are",
            "meaningVi": "có (cái gì ở đâu)",
            "examples": [
                { "en": "There is a sofa and there are two chairs.", "vi": "Có một cái sofa và hai cái ghế.", "highlight": "There is" }
            ],
            "grammar": {
                "ruleVi": "Dùng there is / there are để nói ở đâu đó có cái gì. There is (there's) + danh từ số ít hoặc không đếm được; there are + danh từ số nhiều. Phủ định: there isn't / there aren't. Câu hỏi: Is there …? / Are there …?",
                "forms": [
                    { "label": "có (số ít)", "example": "There's a lamp in my room." },
                    { "label": "có (số nhiều)", "example": "There are three bedrooms." },
                    { "label": "không có", "example": "There isn't a TV. There aren't any chairs." },
                    { "label": "câu hỏi", "example": "Is there a bathroom? Yes, there is. / No, there isn't." }
                ],
                "pitfallsVi": [
                    "Dịch \"có\" thành have: \"In my room have a bed\" → There's a bed in my room.",
                    "\"There have\" → There is / There are.",
                    "Số nhiều quên are: \"There is two chairs\" → There are two chairs.",
                    "Trả lời ngắn không rút gọn: \"Yes, there's\" → Yes, there is."
                ]
            }
        },
