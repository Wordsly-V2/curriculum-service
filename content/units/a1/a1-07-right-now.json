        {
            "slug": "right-now",
            "type": "PHRASE",
            "text": "right now",
            "meaningVi": "ngay lúc này",
            "examples": [
                { "en": "I'm busy right now.", "vi": "Lúc này mình đang bận.", "highlight": "right now" }
            ],
            "noteVi": "Mạnh hơn now một chút. Hay đi với hiện tại tiếp diễn: \"I'm working right now.\""
        },
        {
            "slug": "what-are-you-doing",
            "type": "PHRASE",
            "text": "What are you doing?",
            "meaningVi": "Bạn đang làm gì thế?",
            "examples": [
                { "en": "What are you doing? I'm cooking.", "vi": "Bạn đang làm gì thế? Mình đang nấu ăn.", "highlight": "What are you doing?" }
            ],
            "noteVi": "Khác \"What do you do?\" (Bạn làm nghề gì?). Câu này hỏi việc đang làm lúc nói."
        },
        {
            "slug": "present-continuous",
            "type": "GRAMMAR",
            "text": "am / is / are + -ing",
            "meaningVi": "thì hiện tại tiếp diễn: việc đang xảy ra",
            "examples": [
                { "en": "I'm reading. She's sleeping. They're eating.", "vi": "Mình đang đọc. Cô ấy đang ngủ. Họ đang ăn.", "highlight": "She's sleeping" }
            ],
            "grammar": {
                "ruleVi": "Dùng cho việc đang diễn ra lúc nói. Cấu tạo: am/is/are + động từ thêm -ing. Phủ định thêm not (I'm not working); câu hỏi đảo be lên đầu (Are you working?).",
                "forms": [
                    { "label": "khẳng định", "example": "I'm cooking. He's working. We're eating." },
                    { "label": "phủ định", "example": "I'm not sleeping. She isn't working." },
                    { "label": "câu hỏi", "example": "Are you studying? Yes, I am. / No, I'm not." },
                    { "label": "chính tả -ing", "example": "cook → cooking, write → writing, sit → sitting" }
                ],
                "pitfallsVi": [
                    "Thiếu be: \"I cooking\" → I'm cooking.",
                    "Thiếu -ing: \"I'm cook\" → I'm cooking.",
                    "Động từ tận cùng e thì bỏ e: \"writeing\" → writing; nguyên âm + phụ âm ngắn thì gấp đôi: \"siting\" → sitting.",
                    "Không dùng tiếp diễn với like, want, know: \"I'm liking it\" → I like it."
                ]
            }
        },
        {
            "slug": "im-doing-right-now",
            "type": "PATTERN",
            "text": "I'm … right now.",
            "meaningVi": "Lúc này tôi đang …",
            "examples": [
                { "en": "I'm watching TV right now.", "vi": "Lúc này mình đang xem TV.", "highlight": "I'm watching" }
            ],
            "pattern": {
                "template": "I'm {doing} right now.",
                "slots": [
                    { "name": "doing", "hintVi": "động từ -ing (+ tân ngữ)", "options": ["cooking", "eating lunch", "watching TV"] }
                ]
            },
            "noteVi": "I'm = I am. Nói về người khác: He's / She's / They're + -ing."
        },
