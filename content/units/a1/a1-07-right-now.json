        {
            "slug": "simple-vs-continuous",
            "type": "GRAMMAR",
            "text": "I work / I'm working",
            "meaningVi": "hiện tại đơn và hiện tại tiếp diễn",
            "examples": [
                { "en": "I usually walk to work, but today I'm taking a taxi.", "vi": "Mình thường đi bộ đi làm, nhưng hôm nay mình đi taxi.", "highlight": "I'm taking" }
            ],
            "grammar": {
                "ruleVi": "Hiện tại đơn cho thói quen, việc lặp lại, sự thật (every day, usually, always). Hiện tại tiếp diễn cho việc đang diễn ra lúc nói (now, right now, at the moment).",
                "forms": [
                    { "label": "thói quen", "example": "I drink coffee every morning." },
                    { "label": "đang xảy ra", "example": "I'm drinking tea now." },
                    { "label": "câu hỏi", "example": "What do you do? (nghề) / What are you doing? (đang làm)" }
                ],
                "pitfallsVi": [
                    "Dùng tiếp diễn cho thói quen: \"I'm going to work every day\" → I go to work every day.",
                    "Dùng hiện tại đơn cho việc đang làm: \"Look! It rains.\" → It's raining.",
                    "Nhầm What do you do? với What are you doing?"
                ]
            }
        },
        {
