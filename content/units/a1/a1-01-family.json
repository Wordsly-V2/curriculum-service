            "text": "his",
            "meaningVi": "của anh ấy, của ông ấy",
            "ipa": "/hɪz/",
            "examples": [
                { "en": "This is Tom and his sister.", "vi": "Đây là Tom và em gái của cậu ấy.", "highlight": "his" }
