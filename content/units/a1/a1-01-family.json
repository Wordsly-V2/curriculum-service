            "noteVi": "Giữ âm cuối /f/. Số nhiều bất quy tắc: wives."
        },
        {
            "slug": "possessive-adjectives",
            "type": "GRAMMAR",
            "text": "my / your / his / her / our / their",
            "meaningVi": "tính từ sở hữu: của tôi, của bạn, của anh ấy…",
            "examples": [
                { "en": "Tom is my brother. His wife is Anna.", "vi": "Tom là anh mình. Vợ anh ấy là Anna.", "highlight": "His" }
            ],
            "grammar": {
                "ruleVi": "Tính từ sở hữu đứng trước danh từ và theo người sở hữu, không theo vật được sở hữu: I → my, you → your, he → his, she → her, we → our, they → their.",
                "forms": [
                    { "label": "I → my, you → your", "example": "my mother, your father" },
                    { "label": "he → his, she → her", "example": "his sister, her brother" },
                    { "label": "we → our, they → their", "example": "our family, their parents" }
                ],
                "pitfallsVi": [
                    "Nhầm his và her: dùng his khi người sở hữu là nam, her khi là nữ. \"Lan and her brother\" (không phải his brother).",
                    "Dịch theo thứ tự tiếng Việt: \"mother my\" → \"my mother\".",
                    "Nhầm với đại từ: \"I mother\", \"me mother\" → \"my mother\"."
                ]
            }
        },
        {
            "slug": "his",
