        },
        {
            "slug": "a1-01-brothers-and-sisters",
            "title": "Brothers and sisters",
            "situationVi": "Hai người mới quen hỏi nhau về anh chị em.",
            "lines": [
                { "speaker": "Tom", "en": "Do you have any brothers or sisters?", "vi": "Bạn có anh chị em không?" },
