        {
            "slug": "ordinal-numbers",
            "type": "GRAMMAR",
            "text": "first, second, third, fourth …",
            "meaningVi": "số thứ tự (dùng để nói ngày)",
            "examples": [
                { "en": "My birthday is on October twelfth.", "vi": "Sinh nhật mình vào ngày 12 tháng Mười.", "highlight": "twelfth" }
            ],
            "grammar": {
                "ruleVi": "Ngày trong tháng đọc bằng số thứ tự. Ba số đầu là dạng riêng: first (1st), second (2nd), third (3rd); các số khác thêm -th: fourth, sixth, seventh. Số ghép chỉ đổi số cuối: twenty-first, thirty-first.",
                "forms": [
                    { "label": "1, 2, 3: dạng riêng", "example": "first, second, third (1st, 2nd, 3rd)" },
                    { "label": "thêm -th", "example": "fourth, sixth, seventh, tenth, thirteenth (4th, 6th…)" },
                    { "label": "đổi chính tả", "example": "fifth, eighth, ninth, twelfth, twentieth, thirtieth" },
                    { "label": "số ghép", "example": "twenty-first, twenty-second, thirty-first (21st, 22nd, 31st)" }
                ],
                "pitfallsVi": [
                    "Đọc ngày bằng số đếm: \"May five\" → May fifth.",
                    "\"twenty-oneth\" → twenty-first; \"twenty-twoth\" → twenty-second.",
                    "Bỏ âm cuối /θ/: fifth, sixth, twelfth khó đọc, nhưng thiếu /θ/ là thành số đếm.",
                    "Người Mỹ viết tháng trước ngày: 7/5 là ngày 5 tháng Bảy (July 5th), khác cách viết ở Việt Nam."
                ]
            }
