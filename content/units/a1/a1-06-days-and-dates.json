        {
            "slug": "prepositions-of-time",
            "type": "GRAMMAR",
            "text": "at / on / in (time)",
            "meaningVi": "giới từ chỉ thời gian",
            "examples": [
                { "en": "Let's meet on Saturday at seven o'clock.", "vi": "Mình gặp nhau thứ Bảy lúc bảy giờ nhé.", "highlight": "on Saturday" }
            ],
            "grammar": {
                "ruleVi": "at + giờ; on + thứ hoặc ngày cụ thể; in + tháng, năm, buổi trong ngày. Không dùng giới từ trước today, tomorrow, this/next + thời gian.",
                "forms": [
                    { "label": "at + giờ", "example": "at seven o'clock, at half past six" },
                    { "label": "on + thứ, ngày", "example": "on Monday, on May 5th, on the weekend" },
                    { "label": "in + tháng, năm, buổi", "example": "in June, in 2026, in the morning" },
                    { "label": "không giới từ", "example": "today, tomorrow, this week, next Monday" }
                ],
                "pitfallsVi": [
                    "\"in Monday\", \"at Monday\" → on Monday.",
                    "\"in seven o'clock\" → at seven o'clock.",
                    "\"on tomorrow\", \"in next week\" → tomorrow, next week.",
                    "Có ngày cụ thể thì dùng on dù có tháng: in May, nhưng on May 5th."
                ]
            }
        },
